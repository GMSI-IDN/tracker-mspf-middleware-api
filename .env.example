# Server
PORT=3000
NODE_ENV=development

# Database — sqlite3 untuk dev / pg untuk production
DB_DRIVER=sqlite3
DB_PATH=./data/gateway.db
# DB_DRIVER=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gateway
# DB_USER=postgres
# DB_PASS=secure_password

# JWT
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRY=8h

# Traccar
TRACCAR_URL=https://trackcont.fleet-management-system.co.id
TRACCAR_USERNAME=
TRACCAR_PASSWORD=

# MSPF — OAuth2 client_credentials
MSPF_URL=https://api.cloud-gms.com
MSPF_CLIENT_ID=
MSPF_CLIENT_SECRET=
MSPF_TOKEN_URL=

# Cache — TTL dalam detik
CACHE_DEVICE_TTL=120       # Device list cache (merged Traccar + MSPF)

# MCCS Data History cache TTL (ms). Default 10000.
# Semakin kecil = semakin akurat vs real-time. Semakin besar = semakin ringan ke MSPF.
MCCS_CACHE_TTL=10000        # 10s: akurat. 30000: lebih ringan

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20

# WebSocket
WEBSOCKET_PATH=/api/ws
POLL_INTERVAL=10000          # WS polling interval (ms). Default 10000 (10s).

# Redis (opsional — untuk Socket.io multi-instance)
# REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
REQUEST_TIMEOUT=30000
