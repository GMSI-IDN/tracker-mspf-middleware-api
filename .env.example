# Server
PORT=3000
NODE_ENV=development

# Database — sqlite3 untuk dev / pg untuk production
DB_DRIVER=sqlite3
DB_PATH=./data/gateway.db
# DB_DRIVER=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gateway
# DB_USER=postgres
# DB_PASS=secure_password

# JWT
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRY=8h

# Traccar
TRACCAR_URL=https://trackcont.fleet-management-system.co.id
TRACCAR_USERNAME=
TRACCAR_PASSWORD=

# MSPF — OAuth2 client_credentials
MSPF_URL=https://api.cloud-gms.com
MSPF_CLIENT_ID=
MSPF_CLIENT_SECRET=
MSPF_TOKEN_URL=

# Cache — TTL dalam detik
CACHE_DEVICE_TTL=120       # Device list cache (merged Traccar + MSPF + FoxLogger)

# MCCS Data History cache TTL (ms). Default 10000.
# Semakin kecil = semakin akurat vs real-time. Semakin besar = semakin ringan ke MSPF.
MCCS_CACHE_TTL=10000        # 10s: akurat. 30000: lebih ringan

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20

# WebSocket
WEBSOCKET_PATH=/api/ws
POLL_INTERVAL=10000          # WS polling interval (ms). Default 10000 (10s).

# Redis (opsional — untuk Socket.io multi-instance)
# REDIS_URL=redis://localhost:6379

# FoxLogger — Basic Auth (email & password)
FOXLOGGER_EMAIL=
FOXLOGGER_PASSWORD=
# Timezone untuk interpretasi timestamp naif FoxLogger ("YYYY-MM-DD HH:mm:ss" tanpa zona).
# Data ini dianggap waktu lokal device (default: Asia/Jakarta, UTC+7) lalu dikonversi ke UTC.
FOXLOGGER_TIMEZONE=Asia/Jakarta

# Default timezone untuk user (fallback bila kolom users.timezone kosong, mis. user lama).
# Berlaku untuk default range "hari ini" di endpoint report (mis. /api/reports/route).
DEFAULT_USER_TIMEZONE=Asia/Jakarta

# Live Tracking — online/offline detection & WS emit behavior
# OFFLINE_THRESHOLD_MS: device dianggap offline bila tidak ada data baru > ambang ini. Default 600000 (10 menit).
# online = data terakhir < 10 menit; offline = tidak ada data baru > 10 menit (definisi koneksi).
# Catatan: device sleep (1 jam) / deep sleep (24 jam) akan tampil offline di sela laporan — wajar; sinyal "mati/basi" = running UNKNOWN (>24 jam).
# Hierarki override (yang lebih spesifik menang): per-device (device_metadata) > per-group > per-type > per-source > global.
OFFLINE_THRESHOLD_MS=600000
# Hysteresis: ambang data fresh untuk device kembali online. Default 600000 (10 menit).
ONLINE_THRESHOLD_MS=600000
# Cooldown minimum antar flip status (mencegah berkedip). Default 60000 (1 menit).
STATUS_COOLDOWN_MS=60000
# Override per-source (0 = pakai OFFLINE_THRESHOLD_MS)
# TRACCAR_OFFLINE_THRESHOLD_MS=600000
# MSPF_OFFLINE_THRESHOLD_MS=600000
# FOXLOGGER_OFFLINE_THRESHOLD_MS=600000
# Heartbeat device-status (jaga lastUpdate segar untuk device diam). 0 = off. Default 90000 (90 detik).
DEVICE_STATUS_HEARTBEAT_MS=90000
# Position hanya di-emit saat ada perubahan (lat/lon/speed/course/deviceTime/ignition). Default true.
POSITION_EMIT_CHANGE_ONLY=true

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
REQUEST_TIMEOUT=30000

# Migrasi & seed dijalankan saat startup. Set "false" bila migrasi dijalankan
# lewat step terpisah (dipakai di deploy production).
RUN_MIGRATIONS=true
