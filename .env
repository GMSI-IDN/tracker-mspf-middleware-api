# Server
PORT=3000
NODE_ENV=development

# Database — sqlite3 untuk dev / pg untuk production
DB_DRIVER=sqlite3
DB_PATH=./data/gateway.db
# DB_DRIVER=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gateway
# DB_USER=postgres
# DB_PASS=secure_password

# JWT
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRY=8h

# Traccar
TRACCAR_URL=https://trackcont.fleet-management-system.co.id/api
TRACCAR_USERNAME=test@test.com
TRACCAR_PASSWORD=test

# MSPF — OAuth2 client_credentials
MSPF_URL=https://api.cloud-gms.com
# MSPF_CLIENT_ID=b771111070d843e98060994ce0e9e319
# MSPF_CLIENT_SECRET=dcfbb460acfd48fe8905b59d84020ab7

MSPF_CLIENT_ID=19a16fac1beb4104a68fc8cb018b478e
MSPF_CLIENT_SECRET=40e5d94f67394d62a60611d34f91c2d2
MSPF_TOKEN_URL=


# Cache — TTL dalam detik
CACHE_DEVICE_TTL=120       # Device list cache (merged Traccar + MSPF)

# MCCS Data History cache TTL (ms). Default 10000.
# Semakin kecil = semakin akurat vs real-time. Semakin besar = semakin ringan ke MSPF.
MCCS_CACHE_TTL=30000        # 10s: akurat. 30000: lebih ringan

# Cache
CACHE_TTL=300
CACHE_PROVIDER=node-cache

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20

# WebSocket
WEBSOCKET_PATH=/api/ws
POLL_INTERVAL=30000

# Redis (opsional — untuk Socket.io multi-instance)
# REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
REQUEST_TIMEOUT=30000
